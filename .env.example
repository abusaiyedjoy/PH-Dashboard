# Server & Environment
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/project_review_hub?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/project_review_hub_test?schema=public

# Authentication & JWT
# Minimum 32-character random string for HMAC-SHA256
JWT_SECRET=replace_with_a_secure_random_secret_min_32_characters
JWT_EXPIRES_IN=7d

# Initial privileged account seeded via prisma/seed.ts
SEED_ADMIN_NAME="Platform Administrator"
SEED_ADMIN_EMAIL=admin@projecthub.local
SEED_ADMIN_PASSWORD=AdminPassword123!

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:5001

# Rate Limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_SUBMISSIONS=5
RATE_LIMIT_MAX_LOGIN=5
